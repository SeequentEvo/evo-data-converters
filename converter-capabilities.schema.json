{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seequent.com/schemas/evo-data-converters/converter-capabilities.schema.json",
  "title": "Converter Capabilities",
  "description": "Schema for either a single package-local converter capability file or the generated converter capabilities collection.",
  "oneOf": [
    {
      "$ref": "#/$defs/converter"
    },
    {
      "$ref": "#/$defs/collection"
    }
  ],
  "$defs": {
    "ioBlock": {
      "type": "object",
      "required": [
        "supported"
      ],
      "additionalProperties": false,
      "properties": {
        "supported": {
          "type": "boolean"
        },
        "source_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "produces_evo_objects": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "Use the Geoscience Object Service object-type slug (for example, triangle-mesh). Label metadata outputs that are not Geoscience Object Service object types explicitly."
          }
        },
        "produces_evo_schema_versions": {
          "$ref": "#/$defs/objectSchemaVersions",
          "description": "Geoscience Object Service schema versions emitted for each produced object type."
        },
        "supports_evo_objects": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "Use the Geoscience Object Service object-type slug (for example, triangle-mesh). Label metadata outputs that are not Geoscience Object Service object types explicitly."
          }
        },
        "supports_evo_schema_versions": {
          "$ref": "#/$defs/objectSchemaVersions",
          "description": "Geoscience Object Service schema versions accepted for each supported object type."
        }
      }
    },
    "converter": {
      "type": "object",
      "required": [
        "id",
        "name",
        "package",
        "status",
        "extensions",
        "platform",
        "import",
        "export",
        "limitations"
      ],
      "additionalProperties": false,
      "properties": {
        "$schema": {
          "type": "string"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "package": {
          "type": "string",
          "pattern": "^evo-data-converters-[a-z0-9-]+$"
        },
        "status": {
          "type": "string",
          "enum": [
            "implemented",
            "template_only",
            "planned"
          ]
        },
        "extensions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "platform": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "import": {
          "allOf": [
            {
              "$ref": "#/$defs/ioBlock"
            },
            {
              "required": [
                "supported",
                "source_types",
                "produces_evo_objects"
              ]
            }
          ]
        },
        "export": {
          "allOf": [
            {
              "$ref": "#/$defs/ioBlock"
            },
            {
              "required": [
                "supported",
                "supports_evo_objects"
              ]
            }
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "collection": {
      "type": "object",
      "required": [
        "schema_version",
        "converters"
      ],
      "additionalProperties": false,
      "properties": {
        "$schema": {
          "type": "string"
        },
        "schema_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        },
        "converters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/converter"
          }
        }
      }
    },
    "objectSchemaVersions": {
      "type": "object",
      "description": "Maps a Geoscience Object Service object-type slug to one or more exact schema versions.",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    }
  }
}